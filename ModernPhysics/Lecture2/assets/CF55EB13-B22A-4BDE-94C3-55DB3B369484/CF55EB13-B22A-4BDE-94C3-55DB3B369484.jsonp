8828125}},{"text":"equation.pdf","targetRectangle":{"y":388.54830634593964,"x":1208.4279983520505,"width":165.46684848961786,"height":56.289862516884511}},{"text":"Число «частиц» дискретно ","targetRectangle":{"y":147.04769277572632,"x":26.599999904632568,"width":741.18000000000018,"height":66.404617309570312}},{"text":"— Электронов может быть сколько угодно, если передать полю нужную энергию и не забыть про сохранение электрического заряда","targetRectangle":{"y":825.67285966873169,"x":111.62799835205078,"width":1390.5999999999997,"height":90.192003276824835}},{"text":"￼","targetRectangle":{"y":1033.9999701976776,"x":949.49999516521348,"width":20.015999999999963,"height":21.496002197265625}},{"text":"«Квантовость» поля","targetRectangle":{"y":3.5971571207046509,"x":33,"width":815.6600006459654,"height":100.53440856933594}},{"text":"— Поле никогда не бывает в покое. Даже в отсутствии электронов. Как это называется?","targetRectangle":{"y":962.70490312576294,"x":111.62799835205078,"width":1447.76,"height":90.192003276824835}},{"text":"Что такое «частица»  в квантовой теории поля?","targetRectangle":{"y":280.16955554485321,"x":91.932846069335938,"width":1302.3360005507463,"height":67.3756103515625}},{"text":"Поле заполняет всю Вселенную. ","targetRectangle":{"y":657.08477771282196,"x":111.93284606933594,"width":914.31200036299197,"height":67.3756103515625}},{"text":"— Это волна с энергией, не меньшей, чем масса частицы: ￼","targetRectangle":{"y":388.54830634593964,"x":97.627998352050781,"width":1276.2668484896176,"height":56.289862516884511}},{"text":"— Поле электрона одно во всей Вселенной","targetRectangle":{"y":751.62658679485321,"x":111.62799835205078,"width":826.15999999999985,"height":46.8800048828125}},{"text":"— Если передать полю меньшую энергию, частица не рождается","targetRectangle":{"y":469.25323474407196,"x":97.627998352050781,"width":1236.24,"height":46.8800048828125}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0,1,0,0],"masksT