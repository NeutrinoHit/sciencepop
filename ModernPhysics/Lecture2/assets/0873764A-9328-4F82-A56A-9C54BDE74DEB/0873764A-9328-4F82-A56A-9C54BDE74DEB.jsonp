0312}},{"text":"equation.pdf","targetRectangle":{"y":461.76810383796692,"x":1173.3741298778941,"width":145.62904854620979,"height":49.845628023949757}},{"text":"equation.pdf","targetRectangle":{"y":461.76810383796692,"x":586.92945434570311,"width":160.704675532191,"height":49.845628023949757}},{"text":"￼","targetRectangle":{"y":1033.9999701976776,"x":949.49999516521348,"width":20.015999999999963,"height":21.496002197265625}},{"text":"—Почти не меняет свой размер из-за огромной массы","targetRectangle":{"y":721.4979248046875,"x":68.159454345703125,"width":907.7950000000003,"height":40.020004272460938}},{"text":"Качественное объяснение (Велтон) ","targetRectangle":{"y":3.5971571207046509,"x":52.164252528473867,"width":1112.8200008739532,"height":149.29773679416667}},{"text":"equation.pdf","targetRectangle":{"y":865.90093994140625,"x":497.2350215835018,"width":149.82663672557527,"height":49.507403724884284}},{"text":"equation.pdf","targetRectangle":{"y":941.68115234375,"x":497.2350215835018,"width":149.82663672557527,"height":49.507403724884284}},{"text":"Электрон и его взаимодействие с вакуумом","targetRectangle":{"y":280.16955554485321,"x":91.932846069335938,"width":1217.6080004881619,"height":67.3756103515625}},{"text":"Влияние на энергетические уровни","targetRectangle":{"y":780.02160632610321,"x":91.932846069335938,"width":974.79200038802605,"height":67.3756103515625}},{"text":"— Электрон подвергается влиянию электромагнитного поля в вакууме, которое не знает покоя (квантовый осциллятор). ","targetRectangle":{"y":370.338134765625,"x":68.159454345703125,"width":1600.3750000000005,"height":77.018002891063588}},{"text":"—При ￼ (2P уровень): ￼, поэтому «размывание» электрона не оказывает влияние","targetRectangle":{"y":865.90093994140625,"x":68.159454345703125,"width":1534.8572039633743,"height":49.507403724884284}},{"text":"equation.pdf","targetRectangle":{"y":941.68115234375,"x":178.37445434570316,"width":85.340567237798552,"height":49.253629702273884}},{"text":"— С